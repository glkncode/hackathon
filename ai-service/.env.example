AI_SERVICE_TOKEN=replace-with-a-shared-private-secret

# Ollama's OpenAI-compatible endpoint; no model is downloaded automatically.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
# Set true ONLY after team/organizer approval for a nonlocal inference host.
LLM_ALLOW_REMOTE=false
