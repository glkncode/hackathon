    {
      "id": "transfer.independence",
      "category": "warning",
      "description": "Проверьте независимость представителя, если она требуется внутренними правилами; без подтверждённого правила универсальный запрет не применяется.",
      "source": {
        "name": "Модуль_приказа_о_приеме_и_передаче_дел_и_имущества.docx",
        "version": "sha256:256f38ad302c1241389e28e01db40aa3067dba47779a84bf8d59596768a64635",
        "section": "Общие правила"
      },
      "check": {
        "op": "all",
        "args": [
          {
            "op": "field_not_equals",
            "field": "representative",
            "other_field": "giver"
          },
          {
            "op": "field_not_equals",
            "field": "representative",
            "other_field": "receiver"
          }
        ]
      }
    },
    {
      "id": "transfer.independence_confirmed_rule",
      "category": "blocking",
      "description": "При подтверждённом требовании независимости представитель должен отличаться от сдающего и принимающего. Проверка сравнивает введённые строки, фактическую личность проверьте вручную.",
      "source": {
        "name": "Модуль_приказа_о_приеме_и_передаче_дел_и_имущества.docx",
        "version": "sha256:256f38ad302c1241389e28e01db40aa3067dba47779a84bf8d59596768a64635",
        "section": "Общие правила"
      },
      "when": {
        "op": "all",
        "args": [
          {
            "op": "equals",
            "field": "independence_required",
            "value": "yes"
          },
          {
            "op": "present",
            "field": "independence_basis"
          },
          {
            "op": "present",
            "field": "representative"
          },
          {
            "op": "present",
            "field": "giver"
          },
          {
            "op": "present",
            "field": "receiver"
          }
        ]
      },
      "check": {
        "op": "all",
        "args": [
          {
            "op": "field_not_equals",
            "field": "representative",
            "other_field": "giver"
          },
          {
            "op": "field_not_equals",
            "field": "representative",
            "other_field": "receiver"
          }
        ]
      }
    },
