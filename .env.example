# Docker Compose: only frontend publishes a host port.
COMPOSE_PROJECT_NAME=hackathon
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
POSTGRES_USER=app
# Required. Use a random 32+ character alphanumeric password for automatic URL construction.
POSTGRES_PASSWORD=
POSTGRES_DB=ai_assistant

APP_ENV=development
LOG_LEVEL=info
SERVICE_NAME=ai-assistant

# Optional Compose override. Required when running Go without Compose.
# For reserved characters, percent-encode user/password in this URL; postgres
# still receives the ORIGINAL POSTGRES_PASSWORD. Never commit real credentials.
DATABASE_URL=
# Compose format: postgres://app:<encoded-password>@postgres:5432/ai_assistant?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONNECT_TIMEOUT=10s
DB_MIGRATION_TIMEOUT=60s
AUTO_MIGRATE=true

# Only affects explicitly invoked `migrate down` when APP_ENV=production.
ALLOW_PRODUCTION_MIGRATION_DOWN=false

HTTP_PORT=8080
BOOTSTRAP_ADMIN=true
ADMIN_USERNAME=admin
# Required only when bootstrap is enabled and users is empty. At least 12 characters.
ADMIN_PASSWORD=
SESSION_TTL=12h
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Required together in production (direct HTTPS, no forwarded-header trust).
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=

# Private originals directory (never expose as static files). Limit is bytes.
# Fixed by Compose together with the documents_data volume; used directly outside Compose.
DOCUMENT_STORAGE_DIR=/app/data/documents
DOCUMENT_MAX_UPLOAD_BYTES=20971520

# Private Python service. Compose requires a nonblank shared token.
# Outside Compose, Go can keep workers disabled when the token is empty and RAG is off.
# Compose fixes this internal address; used directly outside Compose.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=
INGESTION_ENABLED=true
INGESTION_WORKERS=1
INGESTION_POLL_INTERVAL=5s
INGESTION_REQUEST_TIMEOUT=120s
INGESTION_MAX_ATTEMPTS=5

# Optional RAG uses the same private URL and X-Service-Token. Errors fall back to search.
RAG_ENABLED=true
RAG_TIMEOUT=60s
RAG_MAX_SOURCES=8
RAG_MAX_HISTORY_MESSAGES=10

# Approved external Qwen; no model is downloaded or run locally.
LLM_BASE_URL=http://192.168.10.117:8000/v1
LLM_MODEL=qwen3.6-35b-a3b
LLM_ALLOW_REMOTE=true
LLM_TIMEOUT=60
LLM_API_KEY=
# Semantic CPU pilot (off by default); first provision model volume explicitly.
SEMANTIC_SEARCH_ENABLED=false
# Backfill independently before enabling retrieval; empty follows search flag.
SEMANTIC_INDEXING_ENABLED=
# Fresh install only: choose a new volume. Existing data: first back up, restore
# and verify, then set the restored volume name (docs/semantic-search-main.md).
POSTGRES_DATA_VOLUME=hackathon_postgres_semantic
SEMANTIC_SUPPLEMENT_FTS=false
SEMANTIC_SEARCH_TIMEOUT=45s
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_REQUEST_TIMEOUT=30s
EMBEDDING_TIMEOUT_SECONDS=30
